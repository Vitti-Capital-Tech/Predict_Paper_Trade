# Copy to web/.env and fill in from Supabase -> Project Settings -> API.
# Use the ANON key here: the dashboard is read-only and RLS blocks writes.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Operator keyword for the sign-in gate: entering it unlocks every account.
# Kept out of source on purpose — pick a non-obvious value in production.
VITE_ACCESS_KEYWORD=trade
