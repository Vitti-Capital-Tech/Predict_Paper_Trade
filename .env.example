# Python worker credentials. Copy to .env and fill in.
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# SERVICE ROLE key (not the anon key). It bypasses RLS so the worker can write.
# Keep it out of the browser and out of git.
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# --- Telegram alerts (worker) -------------------------------------------------
# A bot from @BotFather. Must be Predict's OWN bot, not Option_Scope's: Telegram
# allows one getUpdates consumer per bot, so sharing one breaks both.
TELEGRAM_BOT_TOKEN=
# Where every error goes. Add the bot to the group, send /chatid, paste the
# number here. Unset = errors go to each account's own linked chat.
TELEGRAM_ERROR_CHAT_ID=
# Optional fallback when neither of the above applies.
TELEGRAM_CHAT_ID=
