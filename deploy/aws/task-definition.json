{
  "family": "predict-paper-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/predictWorkerExecutionRole",
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/predict-paper-worker:latest",
      "essential": true,
      "environment": [
        { "name": "TZ", "value": "UTC" }
      ],
      "secrets": [
        {
          "name": "SUPABASE_URL",
          "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/predict/SUPABASE_URL"
        },
        {
          "name": "SUPABASE_SERVICE_KEY",
          "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/predict/SUPABASE_SERVICE_KEY"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/predict-paper-worker",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "worker",
          "awslogs-create-group": "true"
        }
      },
      "stopTimeout": 30
    }
  ]
}
